# Data (never commit large datasets)
data/raw/
data/processed/
data/downloads/
# Never commit extracted split images (keep manifest.csv / split_metadata.json trackable)
data/splits/**/*.png
data/splits/**/*.jpg
data/splits/**/*.jpeg
data/splits/**/*.JPEG
data/splits/**/*.PNG
data/splits/**/*.webp
data/splits/**/*.bmp
# Keep split CSVs and metadata unless they are large; uncomment if needed:
# data/splits/
# data/metadata/

# Models (recursive: checkpoints live in models/baseline/ and models/robust/)
models/**/*.pth
models/**/*.pt
*.ckpt
*.bin

# App / Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# Results: keep metrics/graphs tracked by default; ignore large prediction dumps if needed
# results/predictions/
